# ---------------------------------------------------------------------------
# .env di PRODUZIONE — profilo pilota (EC2 + RDS MySQL + S3 + SES, no Redis).
# Copiare in /var/www/platform/.env sull'istanza e compilare i valori reali
# (output Terraform + segreti generati). NON committare il .env compilato.
# Vedi runbook: platform-infra/runbooks/DEPLOY_PILOT.md §5.
# ---------------------------------------------------------------------------

APP_NAME="Platform"
APP_ENV=production
APP_KEY=                         # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.tuodominio.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=en

# --- Logging: niente dati personali nei log (docs/32 §7) -------------------
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database: endpoint RDS (output terraform: db_endpoint) -----------------
DB_CONNECTION=mysql
DB_HOST=                         # <db_endpoint> dell'output Terraform
DB_PORT=3306
DB_DATABASE=platform
DB_USERNAME=platform
DB_PASSWORD=                     # = var.db_password passata al Terraform

# --- Profilo pilota senza Redis: code/cache/sessioni su file/DB ------------
# (coerente con server/user-data.sh che avvia `queue:work database`)
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true       # solo https in produzione

# --- Storage asset: filesystem locale dell'istanza (profilo pilota) --------
# Il bucket S3 è creato dal Terraform ma NON ancora usato dall'app: l'upload
# logo/immagini è uno step successivo. Per passare a S3 quando servirà:
#   composer require league/flysystem-aws-s3-v3 && FILESYSTEM_DISK=s3
# (l'istanza ha già l'IAM role per il bucket, nessuna credenziale nel .env).
FILESYSTEM_DISK=local

# --- Email transazionali: SES via SMTP (nessun SDK aggiuntivo richiesto) ----
# Crea credenziali "SMTP" dalla console SES → Account dashboard → SMTP settings.
# Endpoint SMTP della regione di Milano: email-smtp.eu-south-1.amazonaws.com
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.eu-south-1.amazonaws.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=                   # SMTP username generato da SES
MAIL_PASSWORD=                   # SMTP password generata da SES
MAIL_FROM_ADDRESS=no-reply@tuodominio.it
MAIL_FROM_NAME="${APP_NAME}"

# --- Crash reporting: Sentry (pacchetto già presente) ----------------------
SENTRY_LARAVEL_DSN=              # DSN del progetto backend su sentry.io
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- JWT: chiavi RS256 generate sull'istanza (storage/keys), non qui -------
JWT_ISSUER=https://api.tuodominio.it
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Rate limiting (docs/25 §6): default prudenti, override se necessario --
RATE_LIMIT_AUTH=5
RATE_LIMIT_AVAILABILITY=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_TENANT=1000
